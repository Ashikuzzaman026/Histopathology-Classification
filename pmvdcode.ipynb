        print(
            f"{row['Metric']:22s}: "
            f"{row['Mean']:.6f} ± "
            f"{row['Standard Deviation']:.6f}"
        )

    return (
        seed_dataframe,
        summary_dataframe,
        class_names,
        class_to_idx,
    )



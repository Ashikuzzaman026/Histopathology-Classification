        "Test Macro Precision",
        "Test Macro F1",
        "Test MCC",
        "Test Cohen Kappa",
    ]

    summary_rows = []

    for metric in test_metric_columns:
        summary_rows.append({
            "Metric": metric,
            "Mean":
